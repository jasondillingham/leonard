# Built binaries
/leonard
/leonard-mcp
/leonard-hook

# Per-project store and runtime state
.leonard/leonard.db
.leonard/leonard.db-journal
.leonard/leonard.db-wal
.leonard/leonard.db-shm
# v0.51 trust-gate fingerprint for [post_edit.verify].command.
# Per-machine, not per-checkout; teams that want shared opt-in
# document a `make trust` step instead.
.leonard/trusted-verifier.sha256
# Orphan SQLite shadow files from concurrent leonard runs (Finder/
# tooling sometimes duplicates the DB and SQLite spawns parallel
# WAL/SHM per copy).
.leonard/leonard *.db
.leonard/leonard *.db-shm
.leonard/leonard *.db-wal

# Go
coverage.out
*.test
*.out

# Personal Claude Code config (per-user wiring, not project-shared)
.claude/settings.local.json

# macOS
.DS_Store
.bosun/

# Ephemeral session/process artifacts at repo root (briefs, scratch
# reports, launch-prep notes). The audits/ directory is the canonical
# home for retained audit history.
/phase-*-brief.md
/bughunt-*-brief.md
/fix-*-brief.md
/launch-readiness-*.md
/resume-here.md
